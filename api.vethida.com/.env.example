# Copy to .env.local and fill in the blanks.
# `node scripts/gen-secrets.mjs` (from the repo root) prints values for the GENERATED ones.
# Dev server runs on http://localhost:3001

# Database
DATABASE_URL=postgresql://vethida:vethida_dev@127.0.0.1:5432/vethida

# Production only. CA cert (PEM) from the DigitalOcean database dashboard.
# DATABASE_CA_CERT=

# Pool size per instance, default 10. Shared connection limit with the portal and bot.
# DATABASE_POOL_MAX=10

# Licensing
# GENERATED. Base64 DER PKCS8 P-256 private key, signs the license tokens.
# The public half goes into SecurityConfig in the desktop app.
LICENSE_SIGNING_KEY=

# Key id put in every token. Has to match LicenseTokenPrimaryKid in
# Vethida/vth_core/Services/SecurityConfig.h exactly, or activations fail on the client.
LICENSE_TOKEN_KID=rens-license-v1

# GENERATED. Shared with the portal and the discord bot (GET /v1/license/lookup).
INTERNAL_API_TOKEN=

# GENERATED. Bearer token for POST /v1/cleanup and GET /api/cron/license-reminders.
CRON_SECRET=

# GENERATED. HMAC key for the stored hardware fingerprint hashes. Don't change it
# after launch, every device would look like a new machine.
FINGERPRINT_PEPPER=

# Polar (sandbox)
POLAR_WEBHOOK_SECRET=
POLAR_ACCESS_TOKEN=
POLAR_SERVER=sandbox

# Desktop auth: where the approval link points
PORTAL_ORIGIN=http://localhost:3000

# Email
# file = write mail to .mail/ instead of sending. Remove it and set RESEND_API_KEY to send for real.
EMAIL_TRANSPORT=file
# RESEND_API_KEY=
# RESEND_FROM=Vethida <license@vethida.com>

# Postal address for the email footer (left out if unset)
# LEGAL_ENTITY_ADDRESS=

# Update feed GET /v1/version reads from
# UPDATE_FEED_URL=https://vethida.com/desktop/updates.json

# Optional
# NEXT_PUBLIC_SENTRY_DSN=
