# Copy to .env.local and fill in the blanks.
# `node scripts/gen-secrets.mjs` (from the repo root) prints values for the GENERATED ones.
# Dev server runs on http://localhost:3000

# Database
DATABASE_URL=postgresql://vethida:vethida_dev@127.0.0.1:5432/vethida

# Production only. CA cert (PEM) from the DigitalOcean database dashboard.
# DATABASE_CA_CERT=

# Pool size per instance, default 10
# DATABASE_POOL_MAX=10

# Auth
# GENERATED. Changing it signs everyone out.
BETTER_AUTH_SECRET=
# Callback/checkout URLs are built from this, keep it local in dev
BETTER_AUTH_URL=http://localhost:3000

# Turnstile (OTP send endpoint). These are Cloudflare's always-pass test keys.
# Site key and secret have to be a matching pair.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Polar (sandbox)
POLAR_ACCESS_TOKEN=
POLAR_SERVER=sandbox

# Product ids. Each tier/cadence is its own Polar product.
# The _LIFETIME ones have to be one-time products, not subscriptions.
# Leave one empty and that option just isn't offered. (POLAR_PRODUCT_PRO without
# a suffix is still read as yearly for older setups)
POLAR_PRODUCT_PRO_YEARLY=
POLAR_PRODUCT_PRO_MONTHLY=
POLAR_PRODUCT_PRO_LIFETIME=
POLAR_PRODUCT_ULTIMATE_YEARLY=
POLAR_PRODUCT_ULTIMATE_MONTHLY=
POLAR_PRODUCT_ULTIMATE_LIFETIME=

# Discord (optional, the link button is hidden unless id, secret and bot token are all set)
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_BOT_TOKEN=
# DISCORD_ROLE_PRO=
# DISCORD_ROLE_ULTIMATE=

# Cron
# GENERATED. Same value as api.vethida.com. Used by POST /api/cron/delete-accounts.
CRON_SECRET=
# true = actually hard delete accounts past the grace period. No undo, keep false locally
HARD_DELETE_ENABLED=false

# Email
# file = write mail to .mail/ (sign-in codes end up there as .txt)
EMAIL_TRANSPORT=file
# RESEND_API_KEY=
# RESEND_FROM=Vethida <noreply@vethida.com>

# Postal address for the email footer, same as the api's
# LEGAL_ENTITY_ADDRESS=

# Optional
# Direct link to the signed installer (scripts/release/publish.mjs prints it)
# NEXT_PUBLIC_DOWNLOAD_URL=
# NEXT_PUBLIC_SENTRY_DSN=
