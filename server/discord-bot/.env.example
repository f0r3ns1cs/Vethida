DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

NODE_ENV=production
LOG_LEVEL=info
# /health and /metrics, keep it on loopback
HEALTH_PORT=8080
HEALTH_HOST=127.0.0.1

WEBSITE_URL=https://vethida.com
PORTAL_URL=https://my.vethida.com
API_BASE_URL=https://api.vethida.com
# leave empty until there's an actual status page
STATUS_URL=
VETHIDA_INTERNAL_API_TOKEN=

DISCORD_ALLOW_LEGACY_KEY_DM=false

DISCORD_ROLE_FOUNDER=
DISCORD_ROLE_TEAM=
DISCORD_ROLE_PARTNER=
DISCORD_ROLE_CUSTOMER=
DISCORD_ROLE_BOOSTER=
DISCORD_ROLE_ANNOUNCEMENTS=
DISCORD_ROLE_CHANGELOG=
DISCORD_ROLE_MUTED=
DISCORD_ROLE_VERIFIED=
DISCORD_ROLE_QUARANTINE=

AUTOMOD_ENABLED=true
MIN_ACCOUNT_AGE_HOURS=72
RAID_JOIN_THRESHOLD=10
RAID_JOIN_WINDOW_SECONDS=30
SPAM_MESSAGE_THRESHOLD=5
SPAM_WINDOW_SECONDS=6
DUPLICATE_THRESHOLD=3

ANTHROPIC_API_KEY=
AI_ENABLED=true
AI_MODEL=claude-haiku-4-5
AI_SUPPORT_CHANNEL_ID=
AI_MAX_HISTORY=10
AI_USER_DAILY_TOKEN_LIMIT=50000
AI_USER_RATE_LIMIT=5
AI_USER_RATE_WINDOW_SECONDS=60
AI_RESPONSE_MAX_TOKENS=800

# Required, same postgres as the api and portal
DATABASE_URL=postgres://vethida:vethida@localhost:5432/vethida

# old name for VETHIDA_INTERNAL_API_TOKEN, still read as a fallback
# ADMIN_TOKEN=
