[Unit]
Description=api.vethida.com Next.js licensing and activation API
After=network.target

[Service]
Type=simple
User=vethida
WorkingDirectory=/opt/api.vethida.com
Environment=NODE_ENV=production
# Ports match each app's `dev` script, so there is one mapping to remember
# rather than one per environment: portal 3000, api 3001, site 3002.
Environment=PORT=3001
Environment=HOSTNAME=127.0.0.1
# Holds LICENSE_SIGNING_KEY, the P-256 private key that signs every license
# token. It exists nowhere else and is the reason this file is 0600 root-owned
# rather than a set of Environment= lines.
EnvironmentFile=/etc/vethida/api.env
ExecStart=/usr/bin/node /opt/api.vethida.com/node_modules/next/dist/bin/next start
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/api.vethida.com
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
