# Copy to /etc/vethida/cron.env, then: chmod 600 /etc/vethida/cron.env
# CRON_SECRET must match the value the Next apps read from their environment.
CRON_SECRET=replace-with-a-long-random-secret
# Local ports each Next app listens on. These match the app `dev` scripts and
# the PORT= line in each systemd unit: portal 3000, api 3001, site 3002.
DELETE_ACCOUNTS_URL=http://127.0.0.1:3000/api/cron/delete-accounts
DISCORD_RECONCILE_URL=http://127.0.0.1:3000/api/cron/discord-reconcile
LICENSE_REMINDERS_URL=http://127.0.0.1:3001/api/cron/license-reminders
CLEANUP_URL=http://127.0.0.1:3001/v1/cleanup
