# Line endings: text files are normalized in the repository. These need a fixed
# ending in the working tree on every machine.
* text=auto

Dockerfile        text eol=lf
*.sh              text eol=lf
*.ps1             text eol=crlf
*.iss             text eol=crlf
scripts/eula.txt text eol=crlf

*.png  binary
*.ico  binary
*.pow  binary
*.dll  binary
*.exe  binary
