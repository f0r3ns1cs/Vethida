# Stripe: Developers > API keys > Secret key
STRIPE_SECRET_KEY=

# Stripe: Developers > Webhooks > endpoint > Signing secret
STRIPE_WEBHOOK_SECRET=

# Encrypts stored license keys. 64 random characters
# generate: openssl rand -hex 32
KEY_SECRET=

# Resend: API Keys > Create.
RESEND_API_KEY=
EMAIL_FROM=Vethida <licenses@vethida.com>
EMAIL_REPLY_TO=support@vethida.com
