#include <windows.h>
#include "..\version.h"

IDI_ICON1		ICON		DISCARDABLE	"..\\resources\\icons\\vethida-blue.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VETHIDA_VERSION_FILE
PRODUCTVERSION  VETHIDA_VERSION_FILE
FILEFLAGSMASK   0x3fL
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
BLOCK "StringFileInfo"
BEGIN
BLOCK "040904b0"
BEGIN
VALUE "CompanyName",      VETHIDA_COMPANY_NAME "\0"
VALUE "FileDescription",  VETHIDA_PRODUCT_NAME " Setup\0"
VALUE "FileVersion",      VETHIDA_VERSION_STRING "\0"
VALUE "InternalName",     "vethida-setup\0"
VALUE "LegalCopyright",   "Copyright (c) 2026 " VETHIDA_COMPANY_NAME "\0"
VALUE "OriginalFilename", "vethida-setup.exe\0"
VALUE "ProductName",      VETHIDA_PRODUCT_NAME "\0"
VALUE "ProductVersion",   VETHIDA_VERSION_STRING "\0"
END
END
BLOCK "VarFileInfo"
BEGIN
VALUE "Translation", 0x409, 1200
END
END
